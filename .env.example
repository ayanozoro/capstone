# Server Port
PORT=3000

# Smee.io Webhook Delivery Channel
SMEE_URL=https://smee.io/your-channel-id

# GitHub Webhook Secret (Set the same secret in GitHub Webhook settings)
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# GitHub App Credentials (Optional if scanning public repos)
GITHUB_APP_ID=your_app_id
GITHUB_APP_PRIVATE_KEY=./github-key.pem
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret

# GitHub Personal Access Token (Alternative for private repos)
GITHUB_TOKEN=
